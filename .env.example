# Copy to .env and edit. Only DB_PASSWORD is required.
# Full reference: docs/docker.md

# --- Database ---------------------------------------------------------------
# Used to create the PostgreSQL database on first start, and by the app to
# connect. Changing it later does not change the password of an existing volume.
DB_PASSWORD=
# DB_NAME=trousseau
# DB_USER=trousseau

# --- Web --------------------------------------------------------------------
# Host port. The app is served at http://<host>:<port>/trousseau/
# TROUSSEAU_PORT=8473
# The address people reach the app at, used for links in emails. Password
# reset ("Forgot your password?") is disabled until this is set.
# TROUSSEAU_BASE_URL=http://wardrobe.lan:8473/trousseau
# Set to true only behind a reverse proxy that sets X-Forwarded-* headers.
# BEHIND_PROXY=false
# Largest accepted request, in bytes (default 256 MB). Data imports embed photos.
# MAX_UPLOAD_BYTES=268435456

# --- Server -----------------------------------------------------------------
# Timezone for the Sunday 17:00 email and "today" in the app.
# TZ=Europe/London
# Maximum JVM heap. Large data imports are read into memory.
# JAVA_MAX_HEAP=1g
# Nightly removal of orphaned photo/receipt data. Leave on unless the database user
# is shared with other software that stores PostgreSQL large objects.
# TROUSSEAU_LARGE_OBJECT_SWEEP=true

# --- Weekly email (SMTP) ----------------------------------------------------
# Leave unset to disable delivery (sends fail and are logged).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=trousseau@example.com
#
# To test with the bundled mail catcher instead:
#   SMTP_HOST=mailpit
#   SMTP_PORT=1025
# and start with: docker compose --profile mailpit up -d
