<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.trousseau</groupId>
    <artifactId>trousseau</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>Trousseau</name>
    <description>Your Smart Wardrobe Manager</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 'release' rather than source/target: it compiles against the Java 21 API
             signatures, not just to Java 21 bytecode, so a newer local JDK cannot let
             through an API that the Temurin 21 runtime image lacks. -->
        <maven.compiler.release>21</maven.compiler.release>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <!-- Keep in step with the Dockerfile's WILDFLY_VERSION. -->
        <wildfly.version>41.0.1.Final</wildfly.version>
        <!-- Must equal the Hibernate ORM version inside that WildFly (modules/system/
             layers/base/org/hibernate/main): entities are bytecode-enhanced against it at
             build time and run on it at deploy time. -->
        <hibernate.version>7.4.5.Final</hibernate.version>
        <lombok.version>1.18.48</lombok.version>
    </properties>

    <dependencies>
        <!-- Jakarta EE 11 API. WildFly provides the implementations, including
             Hibernate ORM, Jakarta Mail and Jakarta JSON. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>11.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Hibernate-specific mapping annotations (@LazyGroup, @Formula, @DynamicUpdate).
             Provided: WildFly supplies Hibernate ORM at runtime. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- PrimeFaces 16 is Jakarta-only and includes the Saga theme. -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>16.0.0</version>
        </dependency>

        <!-- PostgreSQL driver. Not packaged in the WAR: datasources are server-level, so
             the Docker build installs this exact version as a WildFly module. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.13</version>
            <scope>provided</scope>
        </dependency>

        <!-- JBCrypt -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>trousseau</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Declared explicitly: newer JDKs no longer run annotation
                         processors found on the plain classpath. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Bytecode enhancement, so that @Basic(fetch = LAZY) on ClothingItem's photo,
                 thumbnail and receipt is honoured. Without it Hibernate loads every BLOB
                 with every item, and list pages held them in session state (~85 MB per
                 session in testing). -->
            <plugin>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-maven-plugin</artifactId>
                <version>${hibernate.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>enhance</goal>
                        </goals>
                        <!-- Lazy initialization and dirty tracking are always on when
                             enhancing in Hibernate 7 (their switches are deprecated,
                             HHH-15641). Association management and extended enhancement
                             stay at their default, off. -->
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>5.1.5.Final</version>
                <configuration>
                    <version>${wildfly.version}</version>
                    <scripts>
                        <script>${project.basedir}/src/main/scripts/configure-ds.cli</script>
                    </scripts>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
